# Types for the _microkeys module built into MicroKeys.  Scripts use the
# microkeys package instead; this is here so editors can check that package.

def version() -> str: ...
def platform() -> str: ...
def log(level: int, text: str) -> None: ...
def configure(script_dir: str, abort_mods: int, abort_key: str, update_feed: str, check_updates: bool, editor: str) -> None: ...
def set_bindings(hotkeys: list[tuple[int, int, str, str, str, str, str]], hotstrings: list[tuple[int, str, bool, bool, str, str, str]], commands: list[tuple[int, str]], window_events: list[tuple[int, int, str, str, str]]) -> None: ...
def scripts_loaded(ok: bool, summary: str) -> None: ...
def macro_running(what: str) -> None: ...
def console_state(more: bool) -> None: ...
def post(kind: int, id: int, extra: str) -> bool: ...
def paused() -> bool: ...
def cancelled() -> bool: ...
def check_cancel() -> None: ...
def sleep(seconds: float) -> None: ...
def wait_modifiers(timeout: float) -> bool: ...
def is_key(name: str) -> bool: ...
def send_keys(actions: list[tuple[int, str]], delay_ms: int, hold_ms: int, frame_ms: int) -> None: ...
def uses_directinput() -> bool: ...
def cursor() -> tuple[int, int]: ...
def move_cursor(x: int, y: int) -> None: ...
def mouse_button(button: str, down: bool) -> None: ...
def mouse_wheel(clicks: int, horizontal: bool) -> None: ...
def clip_get() -> str | None: ...
def clip_set(text: str) -> bool: ...
def clip_sequence() -> int: ...
def clip_kinds() -> list[str]: ...
def clip_get_data(kind: str) -> bytes | None: ...
def clip_set_data(items: list[tuple[str, bytes]]) -> bool: ...
def clip_save() -> list[tuple[str, bytes]] | None: ...
def clip_restore(items: list[tuple[str, bytes]]) -> bool: ...
def clip_concealed() -> bool: ...
def list_windows(include_hidden: bool) -> list[dict]: ...
def foreground() -> dict | None: ...
def window_info(handle: int) -> dict | None: ...
def activate(handle: int) -> bool: ...
def get_bounds(handle: int) -> tuple[int, int, int, int] | None: ...
def set_bounds(handle: int, x: int, y: int, width: int, height: int) -> bool: ...
def get_state(handle: int) -> str: ...
def set_state(handle: int, state: str) -> bool: ...
def close_window(handle: int) -> bool: ...
def monitors() -> list[dict]: ...
def window_monitor(handle: int) -> int: ...
def msgbox(text: str, title: str, buttons: str) -> str: ...
def ask_text(prompt: str, title: str, initial: str) -> str | None: ...
def ask_choice(items: list[str], prompt: str, title: str) -> int: ...
def toast(title: str, text: str) -> None: ...
def overlay(text: str, timeout_ms: int) -> None: ...
def shell_open(target: str) -> None: ...
